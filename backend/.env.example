# --- Application ---
# ENVIRONMENT drives fail-closed security. Anything other than "development"
# (i.e. "production" or "staging") REQUIRES a strong JWT_SECRET_KEY and forces
# DEBUG off. The default is "production", so a deploy that forgets to set this is
# strict rather than silently insecure. Local dev must set it explicitly.
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Secret used to encrypt API credentials stored in the runtime config ---
# Strongly recommended in production (else provider keys fall back to env vars).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CONFIG_ENCRYPTION_KEY=

# --- Abuse / cost protection (all optional; safe defaults shown) ---
# Rate limits are PROCESS-LOCAL (per worker). Syntax: "<count>/<second|minute|hour>".
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute
INTERVIEW_RATE_LIMIT=30/minute
VOICE_RATE_LIMIT=60/minute
ASSESSMENT_RATE_LIMIT=10/minute
# Login brute-force throttle (per IP + email). Never permanently locks accounts.
LOGIN_THROTTLE_ENABLED=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=300
# Request-size guards (reject before spending on paid APIs).
MAX_STUDENT_MESSAGE_CHARS=2000
MAX_TRANSCRIPT_TURN_CHARS=4000

# --- Priority B: traffic control, telemetry & scalability (all optional) ---
# Telemetry is process-local / in-memory (per worker). See docs/TRAFFIC.md.
ACTIVE_USER_WINDOW_SECONDS=120
TELEMETRY_SAMPLE_INTERVAL_SECONDS=15
LIVE_SESSION_IDLE_PRUNE_SECONDS=900
# Master switch for background threads (sampler + assessment worker).
BACKGROUND_WORKERS_ENABLED=true
# Concurrency guards. GLOBAL (fleet-wide) across all uvicorn workers when
# REDIS_URL is set below; otherwise per-process (see docs/DEPLOYMENT.md).
MAX_CONCURRENT_AI_INTERVIEWS=20
AI_INTERVIEW_WAIT_SECONDS=2.0
# Default sized for the planned eleven_flash_v2_5 TTS setup - a tuning knob,
# not a guaranteed ElevenLabs concurrency limit. Adjust to real headroom.
MAX_CONCURRENT_TTS_REQUESTS=10
TTS_WAIT_SECONDS=0.5

# --- Redis (fleet-wide concurrency control across multiple uvicorn workers) ---
# REQUIRED in production/staging (the app refuses to start without it, unless
# REDIS_REQUIRED_FOR_CONCURRENCY is explicitly set to false). Optional in
# development - without it, concurrency guards fall back to a per-process
# limit (safe only with a single worker). See docs/DEPLOYMENT.md.
REDIS_URL=
# Leave unset to auto-decide by ENVIRONMENT (required in production/staging,
# optional in development). Set explicitly to override either way.
# REDIS_REQUIRED_FOR_CONCURRENCY=true
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
# How long a held concurrency slot survives without being released before it
# self-expires (protects against a crashed worker leaking a slot forever).
REDIS_SEMAPHORE_LEASE_SECONDS=180.0
# Assessment background queue (durable, DB-backed).
ASSESSMENT_QUEUE_ENABLED=true
ASSESSMENT_WORKER_CONCURRENCY=3
ASSESSMENT_POLL_INTERVAL_SECONDS=1.0
# Provider retry/backoff (transient errors only).
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BASE_MS=200
PROVIDER_RETRY_MAX_MS=4000
# Bounded actor context (per-turn cost stays flat as interviews grow).
ACTOR_MAX_RECENT_TURNS=12
ACTOR_CONTEXT_CHAR_LIMIT=12000
# Deployment description (informational; cannot be auto-detected reliably).
DEPLOYMENT_MODE=single_instance
APP_WORKERS=1
# Alert / health thresholds.
ALERT_P95_LATENCY_MS=2000
ALERT_ERROR_RATE=0.05
ALERT_AI_CONCURRENCY_PCT=0.8
ALERT_ASSESSMENT_QUEUE=20
ALERT_DB_POOL_PCT=0.9
ALERT_CPU_PCT=0.90
ALERT_MEMORY_PCT=0.90
# Mock provider mode (LOAD TESTING ONLY - never enable in production).
MOCK_AI=false
MOCK_MODEL_LATENCY_MS=800
MOCK_TTS_LATENCY_MS=300

# --- Priority C: OpenAI capacity + adaptive throttling + access gate ---
# Set these to match your OpenAI project tier for the active model
# (gpt-4o-mini). Defaults below match a ~250K TPM / 3K RPM tier.
OPENAI_TPM_LIMIT=250000
OPENAI_RPM_LIMIT=3000
OPENAI_CAPACITY_BUSY_PCT=0.70
OPENAI_CAPACITY_PROTECTING_PCT=0.85
OPENAI_CAPACITY_CRITICAL_PCT=0.95
# Adaptive assessment workers by capacity state (live interviews keep priority).
ASSESSMENT_WORKERS_BUSY=2
ASSESSMENT_WORKERS_PROTECTING=1
ASSESSMENT_PAUSE_ON_CRITICAL=true
# Email access-request gate. When true, only APPROVED emails may register.
REQUIRE_ACCESS_APPROVAL=false
# Hard safety cap on load-test target users (scalability target: 170).
LOAD_TEST_MAX_USERS=170

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://ptai:ptai@localhost:5432/ptai
# Set to true for quick local dev without running alembic migrations
AUTO_CREATE_TABLES=false
# Connection pool (PostgreSQL only; ignored for SQLite). Per-worker budget -
# fleet-wide connections ~= app_workers x (DB_POOL_SIZE + DB_MAX_OVERFLOW).
# See docs/DEPLOYMENT.md for sizing guidance at 4 workers.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30.0

# --- OpenAI Developer Platform ---
# NEVER commit a real key. Put your key in backend/.env (gitignored) only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=300
OPENAI_PATIENT_MAX_OUTPUT_TOKENS=400
OPENAI_STANDARD_ASSESSMENT_MAX_OUTPUT_TOKENS=1200
OPENAI_REFERRAL_EXTRACTION_MAX_OUTPUT_TOKENS=1500
OPENAI_REFERRAL_DOMAIN_MAX_OUTPUT_TOKENS=1000
OPENAI_REFERRAL_REVIEW_MAX_OUTPUT_TOKENS=2000

# --- ElevenLabs text-to-speech (patient voice) ---
# Backend-only key. The browser never sees it (there is NO VITE_ELEVENLABS_* var).
ELEVENLABS_API_KEY=
# Set to false to disable realistic voices entirely (browser TTS is used instead).
ELEVENLABS_ENABLED=true
ELEVENLABS_DEFAULT_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_SECONDS=20
# Hard cap on synthesizable text length (patient replies are ~900 chars max).
ELEVENLABS_MAX_TEXT_CHARS=1200
# Bounded in-memory audio cache (repeat replies don't re-consume credits).
ELEVENLABS_CACHE_MAX_ENTRIES=24

# --- LiveKit (Phase 1 POC ONLY - not used by the production interview/voice
# path). Leave blank to keep the POC disabled; the token endpoint reports
# itself unavailable (503) until all three of these plus
# LIVEKIT_POC_ENABLED=true are set. Get these from a LiveKit Cloud project -
# self-hosting is explicitly out of scope for Phase 1.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_POC_ENABLED=false

# --- OpenAI Realtime native-voice engine (POC) ---
# Default OFF. When true AND OPENAI_API_KEY is set, the LiveKit worker uses
# OpenAI Realtime as the turn-taking/voice brain (replacing Silero/Deepgram/
# Smart Turn/Phase7/ElevenLabs for that session) while patient_engine stays
# authoritative over WHAT Carly says. Requires openai>=1.107 (met). See
# app/livekit_agent/realtime_client.py / realtime_session.py.
LIVEKIT_REALTIME_ENGINE_ENABLED=false
# controlled (existing backend-authored response) | native_agent (Realtime
# authors wording through restricted patient-truth tools). Default is controlled.
OPENAI_REALTIME_ENGINE_MODE=controlled
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_NATIVE_AGENT_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_SEMANTIC_EAGERNESS=low

# --- Phase 2: server-side VAD/STT on the raw student-audio path (PARALLEL/
# OBSERVATIONAL only - never drives the conversation; see
# app/livekit_agent/worker.py's _StudentVadSttPipeline). Leave blank/false to
# keep it off - the worker silently skips this path and Phase 1 raw-audio
# ingestion (+ the existing browser-SpeechRecognition conversation) is
# unaffected either way. Get a Deepgram key at https://console.deepgram.com/.
LIVEKIT_SERVER_STT_ENABLED=false
DEEPGRAM_API_KEY=

# --- Phase 3: EXPERIMENTAL semantic turn detection (OBSERVATIONAL only -
# see app/livekit_agent/turn_detector.py). A HOLD/END decision here NEVER
# drives the conversation - only logs student_turn_detector_decision.
# Requires LIVEKIT_SERVER_STT_ENABLED=true above; enabling this alone is a
# safe no-op (logged warning, feature stays off).
LIVEKIT_SEMANTIC_TURN_DETECTION_ENABLED=false

# --- Phase 4: EXPERIMENTAL semantic turn CONTROL - once genuinely active
# (requires BOTH flags above to also be true), Smart Turn's HOLD/END decision
# becomes the source of truth for student turn completion in the LiveKit POC,
# and browser SpeechRecognition/student_text is no longer authoritative for
# the session (still accepted/acked, never processed). Enabling this alone,
# without the two Phase 2/3 flags above also true, is a safe no-op (logged
# warning, browser control stays authoritative). Never affects the legacy
# production voice engine.
LIVEKIT_SEMANTIC_TURN_CONTROL_ENABLED=false

# --- Phase 5A: EXPERIMENTAL semantic barge-in - once genuinely active
# (requires ALL THREE flags above to also be true), genuine student
# interruption speech ("wait", "what do you mean?") while the patient is
# speaking stops patient audio and hands the student the floor, reusing the
# SAME cancellation path as the existing manual interrupt button. Short
# acknowledgements ("mm-hmm", "yeah", "okay") never interrupt. Enabling this
# alone, without semantic turn CONTROL already active, is a safe no-op
# (logged warning, no automatic interruption). Never affects the legacy
# production voice engine.
LIVEKIT_SEMANTIC_BARGE_IN_ENABLED=false

# --- Phase 5B: EXPERIMENTAL spoken-transcript sync - fixes a transcript-
# integrity bug (present since Phase 1): the full patient response is
# persisted before any audio plays, so an interrupted turn's DB row could
# show text the student never actually heard. When true, patient audio
# publishes sentence-by-sentence and an interruption (manual OR Phase 5A
# semantic barge-in) corrects the transcript back down to only what
# genuinely finished playing. Independent of Phase 4/5A - useful even with
# both off, since the manual interrupt button works unconditionally. Never
# affects the legacy production voice engine.
LIVEKIT_SPOKEN_TRANSCRIPT_SYNC_ENABLED=false

# --- Phase 6: EXPERIMENTAL patient backchanneling - lets the patient say a
# short, neutral acknowledgement ("Mm-hmm.") during a student's HOLD-
# classified thinking pause. Never a real patient turn: no OpenAI call, no
# transcript row, never touches the student's candidate transcript/turn id,
# cancelled immediately if the student resumes speaking. Requires semantic
# turn CONTROL already active (all three flags above); does NOT require
# semantic barge-in. Enabling this alone is a safe no-op (logged warning,
# no backchannels). Never affects the legacy production voice engine.
LIVEKIT_PATIENT_BACKCHANNEL_ENABLED=false

# --- CORS (comma-separated origins of the React dev server / deployment) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Authentication (JWT) ---
# REQUIRED in production. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER commit the real secret. Put it in backend/.env (gitignored) only.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# Access token lifetime in minutes (default 720 = 12 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Allow open student self-registration via POST /api/auth/register.
ALLOW_STUDENT_SELF_REGISTRATION=true

# --- First-admin bootstrap (read ONLY by scripts/create_admin.py) ---
# Do NOT put a real password here. Set these in your shell or backend/.env
# (gitignored) when running the seed command, then unset them.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator
